{
  "name": "cdktn-action",
  "description": "GitHub Action to run CDK Terrain (CDKTN) with OpenTofu or Terraform in your CI/CD workflow",
  "version": "0.0.0",
  "author": "CDK Terrain",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/cdktn-io/action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdktn-io/action.git"
  },
  "bugs": {
    "url": "https://github.com/cdktn-io/action/issues"
  },
  "keywords": [
    "actions",
    "cdktn",
    "cdktf",
    "opentofu",
    "terraform",
    "cdk"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "package": "rimraf ./dist && rolldown -c rolldown.config.ts",
    "package:watch": "npm run package -- --watch",
    "bundle": "npm run format && npm run package",
    "local-action": "local-action . src/index.ts .env",
    "all": "npm run check && npm run typecheck && npm run test && npm run package"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@github/local-action": "^7.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
